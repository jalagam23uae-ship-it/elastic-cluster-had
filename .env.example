# Docker Compose Environment Variables
# Copy this file to .env and customize for your environment

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xsdplatform
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Backend Configuration
BACKEND_PORT=8080
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JAVA_OPTS=-Xmx1g -Xms512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# JWT Configuration
JWT_SECRET=mySecretKeyForJWTTokenGenerationThatIsLongEnough1234567890ChangeThisInProduction
JWT_EXPIRATION=86400000

# Application Settings
XSD_STORAGE_PATH=./xsd-storage
COMPILE_TEMP=./temp/compile
COMPILE_OUTPUT=./temp/classes

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8080

# Nginx Configuration
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# pgAdmin Configuration
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Redis Configuration (optional)
REDIS_PASSWORD=redis123
REDIS_PORT=6379

# Compose Profiles
# Set to 'development' to enable pgAdmin
# Set to 'production' to enable Nginx and Redis
COMPOSE_PROFILES=development
